// The module map `assemble.sh` copies, beside the bridge's generated header, into the binary
// target's artifact bundle (`CKAReaderBridge.artifactbundle/include/`). The header is named by its
// bare file name because that is where it sits there; `crates/ka-reader-bridge/build.rs` writes it on
// every build of the bridge, and it is never committed.
module CKAReaderBridge [system] {
    header "ka_reader_bridge.h"
    link "ka_reader_bridge"
    export *
}
