{
  "productName": "Nozoki",
  "identifier": "com.kensaiapp.nozoki",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nozoki"
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ]
  }
}
